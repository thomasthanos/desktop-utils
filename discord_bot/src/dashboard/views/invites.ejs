<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <title>Προσκλήσεις</title>
  <link rel="icon" href="/favicon-app.svg?v=2" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="<%= currentTrack ? 'has-active-player' : '' %>" data-page="invites" data-guild-id="<%= selectedGuildId || '' %>">
  <%- include('partials/sidebar') %>

  <main class="main">
    <div class="page-shell">
      <div class="page-header">
        <div class="page-heading">
          <div class="page-eyebrow">Ανάπτυξη Server</div>
          <h1 class="page-title">Προσκλήσεις</h1>
          <p class="page-subtitle">Δείτε ποιοι φέρνουν νέα μέλη στον server σας σε πραγματικό χρόνο.</p>
        </div>
        <button
          type="button"
          id="clearInvitesBtn"
          class="button button-danger"
          style="<%= (logs.length === 0 && (!leaderboard || leaderboard.length === 0)) ? 'display:none;' : '' %>">
          Καθαρισμός όλων
        </button>
      </div>

      <div class="config-section channel-card" id="inviteChannelCard">
        <div class="channel-card-body">
          <span class="channel-card-icon <%= inviteChannel ? 'is-on' : '' %>">
            <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V8l8 5 8-5v10zm-8-7L4 6h16l-8 5z"/></svg>
          </span>
          <div class="channel-card-text">
            <h2 class="config-title">Ανακοινώσεις εισόδων και αποχωρήσεων</h2>
            <% if (inviteChannel) { %>
              <p>Ανακοινώνω αυτή τη στιγμή στο <strong>#<%= inviteChannel.name || inviteChannel.id %></strong>.</p>
            <% } else { %>
              <p>Ανενεργές. Ορίζονται από το Discord με <code>/invite-logger channel</code>.</p>
            <% } %>
          </div>
        </div>
        <% if (inviteChannel && canManagePerms) { %>
          <button type="button" id="disableInviteChannelBtn" class="button button-secondary">Απενεργοποίηση</button>
        <% } %>
      </div>

      <div class="config-section leaderboard-card">
        <div class="section-heading">
          <div><h2 class="config-title">Κορυφαίοι inviters</h2><p>Οι πιο δραστήριοι υποστηρικτές της κοινότητας</p></div>
        </div>
        <% if (leaderboard && leaderboard.length > 0) { %>
          <table class="data-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Χρήστης</th>
                <th>Πραγματικές</th>
                <th>Έφυγαν</th>
                <th>Έμειναν</th>
                <th>Fake</th>
              </tr>
            </thead>
            <tbody>
              <% leaderboard.forEach((row, idx) => { %>
                <tr>
                  <td data-label="Rank"><span class="rank-badge"><%= idx + 1 %></span></td>
                  <td class="user-tag" data-label="User"><%= row.inviter_tag %></td>
                  <% const gone = Number(row.left_invites || 0); %>
                  <% const stayed = Math.max(0, Number(row.total_invites || 0) - gone); %>
                  <td data-label="Πραγματικές"><span class="badge"><%= row.total_invites %></span></td>
                  <td data-label="Έφυγαν">
                    <% if (gone > 0) { %>
                      <span class="badge badge-muted"><%= gone %></span>
                    <% } else { %>
                      <span class="muted">—</span>
                    <% } %>
                  </td>
                  <td data-label="Έμειναν"><span class="badge"><%= stayed %></span></td>
                  <td data-label="Fake">
                    <% if (row.fake_invites > 0) { %>
                      <span class="badge badge-warn"><%= row.fake_invites %></span>
                    <% } else { %>
                      <span class="muted">—</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } else { %>
          <div class="empty-state" style="padding: 18px 0;">Δεν υπάρχουν ακόμη δεδομένα για τον πίνακα κατάταξης.</div>
        <% } %>
      </div>

      <% if (logs.length > 0) { %>
        <div class="section-heading invites-log-heading"><div><h2 class="minimal-title">Πρόσφατες εγγραφές</h2><p>Τελευταία μέλη και οι πηγές των προσκλήσεων τους</p></div></div>
        <div class="table-card">
        <table class="data-table">
          <thead>
            <tr>
              <th>Κίνηση</th>
              <th>Πρόσκληση (Κωδικός)</th>
              <th>Μέλος</th>
              <th>Ποιος προσκάλεσε</th>
              <th>Server</th>
              <th>Σύνολο Προσκλήσεων</th>
              <th>Ημερομηνία</th>
            </tr>
          </thead>
          <tbody>
            <% logs.forEach(log => { %>
              <tr>
                <% const kind = String(log.event || 'join'); %>
                <td data-label="Κίνηση">
                  <% if (kind === 'ban') { %>
                    <span class="badge badge-danger">Ban</span>
                  <% } else if (kind === 'kick') { %>
                    <span class="badge badge-warn">Kick</span>
                  <% } else if (kind === 'leave') { %>
                    <span class="badge badge-muted">Έφυγε</span>
                  <% } else if (log.is_fake) { %>
                    <span class="badge badge-warn">Fake</span>
                  <% } else { %>
                    <span class="badge">Μπήκε</span>
                  <% } %>
                </td>
                <td class="channel" data-label="Code"><%= log.invite_code || '—' %></td>
                <td data-label="New member">
                  <span class="member-cell">
                    <span class="invite-icon">
                      <svg viewBox="0 0 24 24"><path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                    </span>
                    <%= log.invited_tag %>
                  </span>
                </td>
                <td class="user-tag" data-label="Inviter"><%= log.inviter_id === 'unknown' ? '—' : log.inviter_tag %></td>
                <td class="server" data-label="Server"><%= log.guild_name %></td>
                <td data-label="Total invites"><span class="badge"><%= log.total_invites %></span></td>
                <td class="date" data-label="Joined">
                  <%
                    const raw = String(log.timestamp || '').trim();
                    const tail = raw.slice(10);
                    const zoned = /[Zz]/.test(tail) || tail.includes('+') || tail.lastIndexOf('-') > 0;
                    const then = Date.parse(zoned ? raw : raw.replace(' ', 'T') + 'Z');
                    const diff = Date.now() - then;
                    const hours = Math.floor(diff / 3600000);
                    const days = Math.floor(hours / 24);
                    let timeAgo;
                    if (days > 0) timeAgo = 'πριν ' + days + ' ημέρα(ες)';
                    else if (hours > 0) timeAgo = 'πριν ' + hours + ' ώρα(ες)';
                    else timeAgo = 'μόλις τώρα';
                  %>
                  <%= timeAgo %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        </div>
      <% } else { %>
        <div class="empty-state" id="invitesEmpty" style="<%= logs.length > 0 ? 'display:none' : '' %>"><p>Δεν βρέθηκαν προσκλήσεις για αυτόν τον server.</p></div>
      <% } %>
    </div>
  </main>

  <%- include('partials/nowplaying') %>
  <script data-page-script>
    (function () {
      const disableButton = document.getElementById('disableInviteChannelBtn');

      if (disableButton) {
        disableButton.addEventListener('click', async function () {
          const confirmed = await window.dashboardConfirm({
            title: 'Να σταματήσω τις ανακοινώσεις;',
            copy: 'Δεν θα γράφω πια όταν μπαίνει ή φεύγει κάποιος. Το ιστορικό των προσκλήσεων μένει ως έχει.',
            confirmLabel: 'Απενεργοποίηση',
            tone: 'warn'
          });
          if (!confirmed) return;

          const params = new URLSearchParams(window.location.search);
          const guildId = params.get('guildId') || '';
          const url = guildId
            ? '/api/invite-channel?guildId=' + encodeURIComponent(guildId)
            : '/api/invite-channel';

          disableButton.disabled = true;
          fetch(url, { method: 'DELETE' })
            .then(function (response) { return response.json().catch(function () { return {}; }); })
            .then(function (data) {
              if (data.ok) window.location.reload();
              else disableButton.disabled = false;
            })
            .catch(function () { disableButton.disabled = false; });
        });
      }

      const button = document.getElementById('clearInvitesBtn');
      if (!button) return;

      button.addEventListener('click', async function () {
        const confirmed = await window.dashboardConfirm({
          title: 'Καθαρισμός προσκλήσεων;',
          copy: 'Σβήνει όλο το ιστορικό προσκλήσεων αυτού του server — εισόδους, αποχωρήσεις και τον πίνακα κατάταξης. Δεν αναιρείται.',
          confirmLabel: 'Καθαρισμός'
        });
        if (!confirmed) return;

        const params = new URLSearchParams(window.location.search);
        const guildId = params.get('guildId') || '';
        const url = guildId ? '/api/invite-logs?guildId=' + encodeURIComponent(guildId) : '/api/invite-logs';

        button.disabled = true;
        fetch(url, { method: 'DELETE' })
          .then(function (response) { return response.json().catch(function () { return {}; }); })
          .then(function (data) {
            if (data.ok) window.location.reload();
            else button.disabled = false;
          })
          .catch(function () { button.disabled = false; });
      });
    })();
  </script>

  <%- include('partials/live-sync') %>
</body>
</html>
