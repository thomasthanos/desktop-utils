<%
  const gid = selectedGuildId || '';
  const withGuild = (path) => gid ? `${path}?guildId=${encodeURIComponent(gid)}` : path;
  const activeGuild = (guildOptions || []).find((guild) => guild.id === selectedGuildId);
  const caps = typeof capabilities !== 'undefined' && capabilities ? capabilities : {};
  const may = (name) => Boolean(caps[name]);
  const mayManagePerms = typeof canManagePerms !== 'undefined' && canManagePerms;
%>
<nav class="sidebar" aria-label="Primary navigation">
  <a href="<%= withGuild('/') %>" class="sidebar-brand <%= page === 'dashboard' ? 'active' : '' %>" aria-label="Dashboard home">
    <span class="sidebar-brand-mark" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
    </span>
    <span class="sidebar-brand-copy">
      <strong>Pulse</strong>
      <small>Πίνακας Ελέγχου</small>
    </span>
  </a>

  <div class="sidebar-nav">
    <a href="<%= withGuild('/') %>" class="sidebar-item <%= page === 'dashboard' ? 'active' : '' %>" aria-label="Overview" <%= page === 'dashboard' ? 'aria-current="page"' : '' %>>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg>
      <span class="sidebar-label">Επισκόπηση</span>
    </a>
    <% if (may('commands')) { %>
    <a href="<%= withGuild('/commands') %>" class="sidebar-item <%= page === 'commands' ? 'active' : '' %>" aria-label="Commands" <%= page === 'commands' ? 'aria-current="page"' : '' %>>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/></svg>
      <span class="sidebar-label">Εντολές</span>
    </a>
    <% } %>
    <% if (may('transcripts')) { %>
    <a href="<%= withGuild('/clearlogs') %>" class="sidebar-item <%= page === 'clearlogs' || page === 'transcript' ? 'active' : '' %>" aria-label="Clear logs" <%= page === 'clearlogs' || page === 'transcript' ? 'aria-current="page"' : '' %>>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
      <span class="sidebar-label">Ιστορικό Διαγραφών</span>
    </a>
    <% } %>
    <% if (may('invites')) { %>
    <a href="<%= withGuild('/invites') %>" class="sidebar-item <%= page === 'invites' ? 'active' : '' %>" aria-label="Invite tracker" <%= page === 'invites' ? 'aria-current="page"' : '' %>>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
      <span class="sidebar-label">Προσκλήσεις</span>
    </a>
    <% } %>
    <% if (mayManagePerms) { %>
    <a href="<%= withGuild('/permissions') %>" class="sidebar-item <%= page === 'permissions' ? 'active' : '' %>" aria-label="Permissions" <%= page === 'permissions' ? 'aria-current="page"' : '' %>>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1 3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
      <span class="sidebar-label">Δικαιώματα</span>
    </a>
    <% } %>
  </div>

  <div class="sidebar-footer">
    <button type="button" id="serversToggleBtn" class="sidebar-item sidebar-item-toggle" aria-label="Choose server" aria-expanded="false" aria-controls="sidebarExtended">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5zm0 10a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4zm12 0a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2v-4z"/></svg>
      <span class="sidebar-label"><%= activeGuild ? activeGuild.name : 'Επιλογή διακομιστή' %></span>
    </button>

    <% if (typeof authEnabled !== 'undefined' && authEnabled) { %>
    <form method="POST" action="/logout">
      <button type="submit" class="sidebar-item" aria-label="Sign out">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.59L17 17l5-5-5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
        <span class="sidebar-label">Αποσύνδεση</span>
      </button>
    </form>
    <% } %>
  </div>
</nav>

<button type="button" class="sidebar-backdrop" id="sidebarBackdrop" aria-label="Close server chooser" tabindex="-1"></button>
<aside class="sidebar-extended" id="sidebarExtended" aria-hidden="true" aria-label="Server chooser">
  <div class="sidebar-extended-header">
    <div>
      <div class="sidebar-extended-title">Your servers</div>
      <div class="sidebar-extended-subtitle">Switch dashboard context</div>
    </div>
    <button type="button" class="sidebar-panel-close" id="serversCloseBtn" aria-label="Close server chooser">&times;</button>
  </div>
  <div class="sidebar-extended-list">
    <% (guildOptions || []).forEach((g) => { %>
    <button
      type="button"
      class="guild-item <%= selectedGuildId === g.id ? 'active' : '' %>"
      data-guild-select="<%= g.id %>"
      data-guild-name="<%= g.name %>"
      aria-pressed="<%= selectedGuildId === g.id ? 'true' : 'false' %>"
    >
      <% if (g.iconUrl) { %>
        <img src="<%= g.iconUrl %>" alt="" class="guild-icon">
      <% } else { %>
        <span class="guild-icon guild-icon-fallback" aria-hidden="true"><%= (g.name || 'S')[0].toUpperCase() %></span>
      <% } %>
      <span class="guild-item-copy">
        <strong><%= g.name %></strong>
        <small><%= selectedGuildId === g.id ? 'Currently selected' : 'Open dashboard' %></small>
      </span>
      <span class="guild-item-check" aria-hidden="true">&#10003;</span>
    </button>
    <% }) %>
  </div>
</aside>
