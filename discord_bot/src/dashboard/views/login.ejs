<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign in — Bot Dashboard</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <style>
    /* Αυτόνομο styling: η σελίδα login δεν φορτώνει το κύριο stylesheet,
       ώστε να μην εξαρτάται από τίποτα που απαιτεί συνεδρία. */
    :root {
      --bg-primary: #0f1114;
      --bg-card: rgba(26, 28, 32, 0.9);
      --border-light: rgba(255, 255, 255, 0.08);
      --border-medium: rgba(255, 255, 255, 0.12);
      --text-primary: #f1f3f6;
      --text-secondary: #9aa2b0;
      --accent: #cbd5e6;
      --danger: #e74c3c;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: radial-gradient(1200px 600px at 50% -10%, #1a1c22 0%, var(--bg-primary) 60%);
      color: var(--text-primary);
      font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
      padding: 24px;
    }
    .card {
      width: 100%;
      max-width: 380px;
      background: var(--bg-card);
      border: 1px solid var(--border-light);
      border-radius: 14px;
      padding: 32px 28px;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    }
    h1 { margin: 0 0 6px; font-size: 20px; font-weight: 600; letter-spacing: 0.2px; }
    p.sub { margin: 0 0 22px; font-size: 13px; color: var(--text-secondary); }
    label { display: block; font-size: 12px; color: var(--text-secondary); margin-bottom: 7px; }
    input[type="password"] {
      width: 100%;
      padding: 11px 13px;
      border-radius: 9px;
      border: 1px solid var(--border-medium);
      background: rgba(0, 0, 0, 0.3);
      color: var(--text-primary);
      font-size: 14px;
      outline: none;
      transition: border-color 0.15s ease;
    }
    input[type="password"]:focus { border-color: var(--accent); }
    button {
      width: 100%;
      margin-top: 18px;
      padding: 11px;
      border: none;
      border-radius: 9px;
      background: var(--accent);
      color: #14161a;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: filter 0.15s ease;
    }
    button:hover { filter: brightness(1.08); }
    .error {
      margin: 0 0 16px;
      padding: 9px 12px;
      border-radius: 8px;
      background: rgba(231, 76, 60, 0.12);
      border: 1px solid rgba(231, 76, 60, 0.35);
      color: var(--danger);
      font-size: 13px;
    }
  </style>
</head>
<body>
  <form class="card" method="POST" action="/login">
    <h1>Bot Dashboard</h1>
    <p class="sub">Enter the dashboard password to continue.</p>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <label for="password">Password</label>
    <input type="password" id="password" name="password" autocomplete="current-password" autofocus required>
    <input type="hidden" name="next" value="<%= next %>">

    <button type="submit">Sign in</button>
  </form>
</body>
</html>
