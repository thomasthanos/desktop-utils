<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <title>Ιστορικό Διαγραφών</title>
  <link rel="icon" href="/favicon-app.svg?v=2" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="<%= currentTrack ? 'has-active-player' : '' %>" data-page="clearlogs" data-guild-id="<%= selectedGuildId || '' %>">
  <%- include('partials/sidebar') %>

  <main class="main">
    <div class="page-shell">
      <div class="page-header">
        <div class="page-heading">
          <div class="page-eyebrow">Αρχείο συντονισμού</div>
          <h1 class="page-title">Ιστορικό Διαγραφών</h1>
          <p class="page-subtitle">Δείτε το ιστορικό διεγραμμένων μηνυμάτων και ανοίξτε πλήρη αρχεία.</p>
        </div>
        <button
          type="button"
          id="clearAllBtn"
          class="button button-danger"
          style="<%= logs.length === 0 ? 'display:none;' : '' %>">
          Καθαρισμός όλων
        </button>
      </div>

      <div class="table-card">
      <table class="data-table" id="clearLogsTable" style="<%= logs.length === 0 ? 'display:none' : '' %>">
        <thead>
          <tr>
            <th>Συντονιστής</th>
            <th>Κανάλι</th>
            <th>Μηνύματα</th>
            <th>Server</th>
            <th>Ημερομηνία</th>
            <th>Ενέργειες</th>
          </tr>
        </thead>
        <tbody id="clearLogsBody">
          <% logs.forEach(log => { %>
            <tr id="clear-log-row-<%= log.id %>">
              <td class="user-tag" data-label="Moderator"><%= log.moderator_tag %></td>
              <td class="channel" data-label="Channel">#<%= log.channel_name %></td>
              <td data-label="Messages"><%= log.message_count %> μηνύματα</td>
              <td class="server" data-label="Server"><%= log.guild_name %></td>
              <td class="date" data-label="Date"><%= new Date(log.timestamp).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' }) %></td>
              <td data-label="Action">
                <div class="table-actions">
                  <a href="/transcript/<%= log.id %><%= selectedGuildId ? ('?guildId=' + selectedGuildId) : '' %>" class="table-action table-action-primary">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/></svg>
                    Transcript
                  </a>
                  <button type="button" class="delete-log-btn table-action table-action-danger" data-log-id="<%= log.id %>" title="Διαγραφή ιστορικού" aria-label="Delete log">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <div class="empty-state" id="clearLogsEmpty" style="<%= logs.length > 0 ? 'display:none' : '' %>"><p>Δεν βρέθηκε ιστορικό διαγραφών για αυτόν τον server.</p></div>
      </div>
    </div>
  </main>

  <%- include('partials/nowplaying') %>
  <script data-page-script>
  (function () {
    const clearAllBtn = document.getElementById('clearAllBtn');

    function clearLogsUrl() {
      const guildId = new URLSearchParams(window.location.search).get('guildId') || '';
      return guildId ? `/api/clear-logs?guildId=${encodeURIComponent(guildId)}` : '/api/clear-logs';
    }

    async function fetchAndRenderClearLogs() {
      const guildId = new URLSearchParams(window.location.search).get('guildId') || '';
      const res = await fetch(clearLogsUrl());
      const logs = await res.json();
      const tbody = document.getElementById('clearLogsBody');
      const table = document.getElementById('clearLogsTable');
      const empty = document.getElementById('clearLogsEmpty');
      if (!tbody) return;
      if (!logs.length) {
        if (table) table.style.display = 'none';
        if (empty) empty.style.display = '';
        if (clearAllBtn) clearAllBtn.style.display = 'none';
        tbody.innerHTML = '';
        return;
      }
      if (table) table.style.display = '';
      if (empty) empty.style.display = 'none';
      tbody.innerHTML = logs.map((log) => {
        const date = new Date(log.timestamp).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' });
        const guildParam = guildId ? `?guildId=${encodeURIComponent(guildId)}` : '';
        const href = `/transcript/${log.id}${guildParam}`;
        return `<tr id="clear-log-row-${log.id}">
          <td class="user-tag" data-label="Moderator">${log.moderator_tag}</td>
          <td class="channel" data-label="Channel">#${log.channel_name}</td>
          <td data-label="Messages">${log.message_count} items</td>
          <td class="server" data-label="Server">${log.guild_name}</td>
          <td class="date" data-label="Date">${date}</td>
          <td data-label="Action"><div class="table-actions">
            <a href="${href}" class="table-action table-action-primary">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"/></svg>Transcript</a>
            <button type="button" class="delete-log-btn table-action table-action-danger" data-log-id="${log.id}" title="Delete log" aria-label="Delete log">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
            </button>
          </div></td>
        </tr>`;
      }).join('');
      bindDeleteButtons();
    }

    async function deleteOne(id, btn) {
      const confirmed = await window.dashboardConfirm({
        title: 'Διαγραφή αρχείου;',
        copy: 'Σβήνει οριστικά αυτό το αρχείο και τα αποθηκευμένα του αρχεία. Δεν αναιρείται.',
        confirmLabel: 'Διαγραφή'
      });
      if (!confirmed || !id) return;

      if (btn) btn.disabled = true;
      try {
        const res = await fetch(`/api/clear-logs/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.ok) await fetchAndRenderClearLogs();
        else if (btn) btn.disabled = false;
      } catch { if (btn) btn.disabled = false; }
    }

    async function clearAll() {
      const confirmed = await window.dashboardConfirm({
        title: 'Καθαρισμός όλου του ιστορικού;',
        copy: 'Σβήνει ΟΛΑ τα αρχεία αυτού του server μαζί με τις εικόνες και τα GIF που κρατήθηκαν. Δεν αναιρείται.',
        confirmLabel: 'Καθαρισμός όλων'
      });
      if (!confirmed) return;

      if (clearAllBtn) clearAllBtn.disabled = true;
      try {
        const res = await fetch(clearLogsUrl(), { method: 'DELETE' });
        const data = await res.json();
        if (data.ok) await fetchAndRenderClearLogs();
      } catch { /* η λίστα μένει όπως ήταν */ }
      if (clearAllBtn) clearAllBtn.disabled = false;
    }

    function bindDeleteButtons() {
      document.querySelectorAll('.delete-log-btn').forEach((btn) => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => deleteOne(btn.dataset.logId, btn));
      });
    }

    // Το κουμπί δενόταν μέσα στο render, που τρέχει μόνο μετά από διαγραφή —
    // οπότε με φρέσκια σελίδα δεν έκανε τίποτα.
    if (clearAllBtn) clearAllBtn.addEventListener('click', clearAll);
    bindDeleteButtons();

    const observer = new MutationObserver(() => bindDeleteButtons());
    const tbody = document.getElementById('clearLogsBody');
    if (tbody) observer.observe(tbody, { childList: true });
  })();
  </script>
  <%- include('partials/live-sync') %>
</body>
</html>
