{
  "name": "discord-dashboard-bot",
  "version": "1.0.0",
  "description": "Discord bot with a synced Node.js dashboard",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "check": "node --check src/index.js && node --check src/dashboard/server.js && node --check src/database.js",
    "lint": "eslint src",
    "test": "node src/tests/run.js",
    "smoke": "node src/tests/smoke.js",
    "backup": "node src/tools/backup-db.js",
    "diag:ai": "node src/tools/diag-ai.js",
    "diag:extractors": "node src/tools/diag-extractors.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.10",
    "better-sqlite3": "^13.0.3",
    "discord-player": "^7.1.2",
    "discord-player-youtubei": "^2.0.0",
    "discord.js": "^14.19.3",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "mediaplex": "^1.0.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "socket.io": "^4.8.1",
    "youtube-dl-exec": "^3.1.4",
    "youtubei.js": "^17.2.0"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0"
  },
  "//overrides": "discord-player-youtubei@2.0.0 pins youtubei.js ^16, which YouTube now rejects with HTTP 400 on every /youtubei/v1/player and /search call — every search returns zero results. 17.x speaks the current protocol. Remove this once discord-player-youtubei ships a stable release that depends on ^17.",
  "overrides": {
    "discord-player-youtubei": {
      "youtubei.js": "^17.2.0"
    }
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "ffmpeg-static": "^5.3.0",
    "nodemon": "^3.1.9"
  }
}
