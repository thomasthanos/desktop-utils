# =============================================================================
# Discord bot — παράδειγμα ρυθμίσεων.
# Αντίγραψέ το σε .env και συμπλήρωσε τις τιμές. Το .env ΔΕΝ μπαίνει ποτέ σε git.
# Στον server οι τιμές ζουν στο /etc/discord-bot.env (chmod 600), όχι σε .env.
# =============================================================================

# --- ΑΠΑΡΑΙΤΗΤΑ ---------------------------------------------------------------

# Token του bot από το Discord Developer Portal -> Bot -> Reset Token.
# Διαβάζεται και ως DISCORD_TOKEN (src/index.js:18) — αρκεί το ένα από τα δύο.
DISCORD_BOT_TOKEN=

# Application ID από το Developer Portal -> General Information.
# Χρειάζεται για την καταχώρηση των slash commands.
CLIENT_ID=


# --- ΠΡΟΑΙΡΕΤΙΚΑ: μουσική -----------------------------------------------------

# Spotify credentials. Χωρίς αυτά τα Spotify links εξακολουθούν να δουλεύουν
# (μέσω oembed -> αναζήτηση YouTube) αλλά χωρίς σωστά metadata για playlists.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Πηγή του 24/7 ραδιοφώνου. Δέχεται ΟΠΟΙΟΔΗΠΟΤΕ stream URL δέχεται το ffmpeg.
#
# Άφησέ το ΚΕΝΟ για την προεπιλογή: το lofi girl του YouTube
# (https://www.youtube.com/watch?v=4xDzrJKXOOY).
#
# Το YouTube μπλοκάρει τα datacenter IPs, οπότε από VPS χρειάζεται ταυτότητα:
# όρισε το YT_COOKIE πιο κάτω. Χωρίς αυτό το ραδιόφωνο δεν ξεκινάει καθόλου,
# με «Sign in to confirm you're not a bot».
#
# Ένα Icecast stream δεν θέλει καμία ταυτότητα και δεν λήγει ποτέ — π.χ.
# https://ice1.somafm.com/fluid-128-mp3 (instrumental hip hop, το πλησιέστερο
# σε lofi) ή groovesalad-256-mp3. Είναι η έξοδος αν βαρεθείς τη συντήρηση.
IDLE_MUSIC_URL=

# pcm  = ffmpeg -> raw PCM -> Opus encoder της Node (υποστηρίζει live ένταση)
# opus = ffmpeg κωδικοποιεί σε Opus (λιγότερη CPU, ΧΑΝΕΤΑΙ η live ένταση)
IDLE_STREAM_MODE=pcm


# --- ΠΡΟΑΙΡΕΤΙΚΑ: YouTube από datacenter IP -----------------------------------
# Το YouTube μπλοκάρει τα datacenter IPs με «Sign in to confirm you're not a
# bot». Αφορά ΚΑΙ το /play ΚΑΙ το 24/7 ραδιόφωνο.

# Η ΛΥΣΗ: cookies από Firefox. Ένα script τα κάνει όλα (εξαγωγή, αποστολή,
# ρύθμιση, restart) και μπαίνει σε Scheduled Task για ημερήσια ανανέωση:
#
#   local/refresh-youtube-cookies.ps1     (βλ. §9.1 του DEPLOY.md)
#
# ΧΡΗΣΙΜΟΠΟΙΗΣΕ ΛΟΓΑΡΙΑΣΜΟ ΜΙΑΣ ΧΡΗΣΗΣ. Τα cookies φτιάχνονται σε οικιακή IP
# και χρησιμοποιούνται από datacenter IP — μοτίβο που η Google παρακολουθεί.
# Ποτέ τον κύριο λογαριασμό σου.
#
# ΔΙΑΠΙΣΤΕΥΤΗΡΙΑ: μόνο στο /etc/discord-bot.env (600 root:root), ποτέ σε git.
#
# Το YT_OAUTH υποστηρίζεται επίσης και ο κώδικας δέχεται όποιο από τα δύο
# υπάρχει — αλλά ΜΕΤΡΗΘΗΚΕ ότι το OAuth συνδέεται και μετά το YouTube απαντά
# 400 σε κάθε client, ενώ τα cookies περνάνε καθαρά. Μη χάσεις χρόνο εκεί.
YT_OAUTH=

# Raw Cookie header για /play και ραδιόφωνο. Το γράφει το script παραπάνω —
# ΠΡΕΠΕΙ να είναι σε εισαγωγικά, γιατί περιέχει «; ».
YT_COOKIE=

# Netscape cookies.txt, για την εφεδρική διαδρομή yt-dlp.
YT_COOKIES_FILE=

# Ο InnerTube client που δηλώνεται στο YouTube.
#
# ΠΡΟΣΟΧΗ: εδώ έγραφε ότι το TV_EMBEDDED «περνάει χωρίς cookies και χωρίς
# λογαριασμό, άρα δεν λήγει ποτέ». ΙΣΧΥΕ ΚΑΠΟΤΕ — ΟΧΙ ΠΙΑ. Μετρήθηκε στον
# server ότι κάθε τιμή (tv_embedded, android_vr, tv, ios...) απορρίπτεται με
# «Sign in to confirm you're not a bot». Δεν βλάπτει να μείνει, και ίσως
# ξαναβοηθήσει αν το YouTube χαλαρώσει, αλλά ΔΕΝ αντικαθιστά το YT_OAUTH.
# Έγκυρες: IOS WEB MWEB ANDROID YTMUSIC YTMUSIC_ANDROID YTSTUDIO_ANDROID
#          TV TV_SIMPLY TV_EMBEDDED YTKIDS WEB_EMBEDDED WEB_CREATOR
YT_CLIENT=TV_EMBEDDED

# Το αντίστοιχο για το yt-dlp (πεζά, με κόμμα για πολλαπλούς).
YTDLP_EXTRACTOR_ARGS=youtube:player_client=tv_embedded,android_vr

# PoToken: αποδεικνύει στο YouTube ότι το αίτημα έρχεται από πραγματικό
# περιβάλλον browser. Ενεργό από προεπιλογή — κοστίζει ~40-60MB RAM.
# Βάλε 0 μόνο αν σε στριμώχνει η μνήμη.
YT_POTOKEN=1

# Δεύτερη διαδρομή επίλυσης ροής μέσω yt-dlp. Ενεργή από προεπιλογή.
YT_USE_YTDLP=1

# 1 = ο extractor δεν φέρνει δεδομένα player. Τότε τα ΑΜΕΣΑ video URL σκάνε με
# «Streaming data not available» (η αναζήτηση με κείμενο δουλεύει κανονικά, γι'
# αυτό το πρόβλημα φαίνεται μόνο στα links). Άφησέ το 0.
YT_DISABLE_PLAYER=0

# Επίπεδο καταγραφής του YouTube extractor: NONE INFO DEBUG.
# Με NONE, μια αποτυχία εμφανίζεται ως ανεξήγητο «Extractor: N/A».
YT_LOG_LEVEL=NONE


# --- ΠΡΟΑΙΡΕΤΙΚΑ: dashboard ---------------------------------------------------

PORT=3000

# 127.0.0.1 = προσβάσιμο μόνο τοπικά (μέσω Cloudflare Tunnel). ΜΗΝ το κάνεις
# 0.0.0.0 σε server — εκθέτει κάθε αρχειοθετημένο μήνυμα στο internet.
DASHBOARD_HOST=127.0.0.1

# Η ΔΗΜΟΣΙΑ διεύθυνση του dashboard — αυτή που δίνει η εντολή /logs (!logs).
# Είναι το hostname του Cloudflare Tunnel, όχι το DASHBOARD_HOST από πάνω: το
# δεύτερο λέει πού ακούει ο server τοπικά, το πρώτο πού τον βρίσκει ο κόσμος.
# Χωρίς αυτό, η /logs απαντά ότι δεν έχει ρυθμιστεί αντί να δώσει λάθος link.
DASHBOARD_URL=

# Σύνδεση με Discord. Χωρίς αυτά, το dashboard δέχεται μόνο κωδικό — και τότε
# ΔΕΝ επιτρέπει έλεγχο μουσικής, γιατί δεν ξέρει ποιος είσαι για να δει αν
# βρίσκεσαι σε voice κανάλι. Τα παίρνεις από το Discord Developer Portal
# (Applications -> το bot σου -> OAuth2).
#
# Στο ίδιο σημείο, στα Redirects, πρόσθεσε ΑΚΡΙΒΩΣ αυτό (με το DASHBOARD_URL σου):
#   https://dash.example.com/auth/discord/callback
# Αν δεν ταιριάζει χαρακτήρα προς χαρακτήρα, το Discord απορρίπτει τη σύνδεση.
DISCORD_CLIENT_ID=

# ΜΥΣΤΙΚΟ. Ποτέ στο git — μόνο στο /etc/discord-bot.env με δικαιώματα 600.
DISCORD_CLIENT_SECRET=

# Ποιοι λογαριασμοί Discord μπαίνουν στο dashboard, χωρισμένοι με κόμμα.
# Το BOT_OWNER_ID μετράει αυτόματα, οπότε συνήθως το αφήνεις κενό.
# ΠΡΟΣΟΧΗ: αν δεν υπάρχει ΚΑΝΕΝΑ id ούτε εδώ ούτε στο BOT_OWNER_ID, η σύνδεση
# με Discord μένει απενεργοποιημένη — αλλιώς θα έμπαινε οποιοσδήποτε στον κόσμο.
DASHBOARD_ALLOWED_USERS=

# Πόσο γρήγορα πρέπει να φύγει κάποιος για να μετρήσει fake η πρόσκλησή του.
# Fake μετράει και όποιος ξαναμπαίνει, ανεξάρτητα από τον χρόνο. Προεπιλογή:
# 10 λεπτά. Το κανάλι ανακοινώσεων ορίζεται με /invite-logger channel.
INVITE_FAKE_WINDOW_MS=600000

# Πόσο νέος πρέπει να είναι ένας λογαριασμός για να μετρήσει fake η είσοδός
# του. Λογαριασμός φτιαγμένος χθες που μπαίνει με πρόσκληση είναι το κλασικό
# μοτίβο για φουσκωμένα invites. 0 = σβήνει τον κανόνα. Προεπιλογή: 3 μέρες.
INVITE_MIN_ACCOUNT_AGE_DAYS=3

# Κωδικός εισόδου στο dashboard. Δίνει πλήρη προβολή, αλλά όχι έλεγχο μουσικής.
# Κράτα τον ως εφεδρεία ώστε μια λάθος ρύθμιση OAuth να μη σε κλειδώσει έξω.
DASHBOARD_PASSWORD=

# Τυχαίο μυστικό για την υπογραφή του cookie συνεδρίας. Παράγεται με:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Αν αλλάξει, αποσυνδέονται όλες οι ανοιχτές συνεδρίες. Αν λείπει, παράγεται
# τυχαίο ανά εκκίνηση — δηλαδή αποσυνδέεσαι σε κάθε restart.
DASHBOARD_SECRET=

# Το cookie στέλνεται μόνο μέσω HTTPS. Βάλ' το 0 ΜΟΝΟ για τοπική δοκιμή σε
# http://localhost, αλλιώς ο browser απορρίπτει σιωπηλά το cookie και μοιάζει
# σαν να μη δουλεύει το login.
DASHBOARD_COOKIE_SECURE=1

# Επιτρεπόμενα origins για τις συνδέσεις WebSocket, χωρισμένα με κόμμα.
# Κενό = μόνο το ίδιο host με το αίτημα (σωστό για Cloudflare Tunnel).
# π.χ. DASHBOARD_ORIGINS=https://dash.thomast.uk
DASHBOARD_ORIGINS=


# --- ΠΡΟΑΙΡΕΤΙΚΑ: συμπεριφορά -------------------------------------------------

# Πρόθεμα για τις εντολές κειμένου. Default: !
COMMAND_PREFIX=!

# Το Discord ID σου. Χωρίς αυτό το isBotOwner() επιστρέφει πάντα false, δηλαδή
# δεν μπορείς να χρησιμοποιήσεις το /addauthorized σε servers που δεν είναι
# δικοί σου, και δεν λαμβάνεις τις ειδοποιήσεις βλάβης σε DM.
# Δέχεται και λίστα χωρισμένη με κόμμα στο BOT_OWNER_IDS.
BOT_OWNER_ID=

# Αν οριστεί, τα slash commands καταχωρούνται μόνο σε αυτό το guild (άμεσα,
# χρήσιμο για δοκιμές). Αν λείπει, καταχωρούνται σε όλα τα guilds.
GUILD_ID=


# --- ΠΡΟΑΙΡΕΤΙΚΑ: αρχεία & δίσκος ---------------------------------------------

# Μέγιστο μέγεθος ΕΝΟΣ attachment που αρχειοθετείται από /clear και
# /wipe-channel. Ήταν 500MB — αρκετό για να γεμίσει τη RAM μικρού server.
ATTACHMENT_MAX_MB=25

# Διαγραφή αρχειοθετημένων αρχείων παλαιότερων από τόσες ημέρες.
ATTACHMENT_RETENTION_DAYS=30

# Οροφή συνολικού μεγέθους του data/attachments. Πάνω από αυτό διαγράφονται
# τα παλαιότερα πρώτα.
ATTACHMENT_MAX_TOTAL_MB=5000


# --- ΠΡΟΑΙΡΕΤΙΚΑ: διαδρομές εκτελέσιμων ---------------------------------------
# Άφησέ τα κενά σε Windows (χρησιμοποιούνται τα πακέτα npm).
# Σε Linux server δείξε στα system binaries.

# FFMPEG_PATH=/usr/bin/ffmpeg
# YTDLP_PATH=/usr/local/bin/yt-dlp


# --- ΠΡΟΑΙΡΕΤΙΚΑ: logging & λειτουργικά --------------------------------------

# error | warn | info | debug
LOG_LEVEL=info

# Παλιό συνώνυμο του LOG_LEVEL=debug, μόνο για τον ήχο.
DEBUG_AUDIO=

# 1 = ενεργοποίηση του lock αρχείου που εμποδίζει δεύτερη ταυτόχρονη εκκίνηση.
# Περιττό κάτω από systemd, το οποίο το εγγυάται ήδη.
INSTANCE_LOCK=

# 1 = καθαρισμός των global slash commands σε αυτή την εκκίνηση. Τρέξ' το μία
# φορά αν έχεις διπλές εντολές, μετά ξαναβγάλ' το.
CLEAR_GLOBAL_COMMANDS=

# Πόση ώρα (ms) μένει το bot σε άδειο κανάλι πριν αποσυνδεθεί. Ισχύει και για
# την ουρά και για το ραδιόφωνο. Προεπιλογή 300000 = 5 λεπτά.
#
# Τα 5 λεπτά αντί για ακαριαία έξοδο: μια πτώση σύνδεσης ή ένα σύντομο
# βγες-μπες δεν πρέπει να κόβει τη μουσική. Στα 0 επιστρέφει η παλιά
# συμπεριφορά (αποσύνδεση τη στιγμή που φεύγει ο τελευταίος).
VOICE_EMPTY_GRACE_MS=


# --- ΠΡΟΑΙΡΕΤΙΚΑ: AI ----------------------------------------------------------
#
# ΧΩΡΙΣ ΚΛΕΙΔΙ ΔΕΝ ΑΛΛΑΖΕΙ ΤΙΠΟΤΑ: η /ask δεν φορτώνεται καν, λείπει από το
# /help και από τις καταχωρήσεις, και το fetch δεν καλείται ποτέ.
#
# Κλειδί δωρεάν, χωρίς κάρτα: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# gemini (προεπιλογή) ή groq. Το groq θέλει GROQ_API_KEY.
AI_PROVIDER=

# Κενό = gemini-flash-lite-latest.
#
# Ψευδώνυμο και όχι καρφωμένη έκδοση επίτηδες: η Google αποσύρει μοντέλα για
# ΝΕΑ κλειδιά ενώ τα παλιά συνεχίζουν — και το ListModels τα δείχνει κανονικά
# ενώ η κλήση απαντάει 404. Το σύμπτωμα είναι σιωπηλό, γιατί το bot πέφτει
# στον εφεδρικό router και απαντάει σαν να μη συμβαίνει τίποτα.
#
# Αν θες συγκεκριμένο: `npm run diag:ai` δείχνει τι δέχεται το κλειδί σου.
AI_MODEL=

# Μέγιστες κλήσεις ανά ημέρα. Ο μετρητής ζει στη ΒΑΣΗ, όχι στη μνήμη, ώστε να
# μη μηδενίζεται σε κάθε restart ενώ η πραγματική ποσόστωση της Google συνεχίζει.
# Προεπιλογή 800.
AI_DAILY_BUDGET=

# 0 = διακόπτης πανικού. Η κουβέντα συνεχίζει, καμία εντολή δεν εκτελείται.
AI_ALLOW_ACTIONS=

# Πόσες πειραχτικές ατάκες γράφει το AI στο τέλος του /clear ανά ημέρα.
# Προεπιλογή 40. Το 0 τις σβήνει εντελώς.
#
# Ξεχωριστό από το AI_DAILY_BUDGET επίτηδες: η ατάκα είναι στολίδι και δεν
# πρέπει ποτέ να φάει την ποσόστωση που χρειάζεται το /ask για να δουλέψει.
# Κάθε κλήση κοστίζει ~100 tokens εισόδου και το πολύ 40 εξόδου, με χρονικό
# όριο 2,5 δευτερολέπτων — αν αργήσει, μπαίνει το σκέτο μήνυμα.
#
# Στο AI φεύγουν ΜΟΝΟ αριθμοί: πλήθος μηνυμάτων, πόσα άτομα, πόσα είχαν αρχεία
# ή συνδέσμους, σε πόσες μέρες ήταν απλωμένα. ΠΟΤΕ το περιεχόμενο των
# μηνυμάτων και ποτέ ονόματα χρηστών.
AI_QUIP_DAILY=


# --- ΠΡΟΑΙΡΕΤΙΚΑ: backups -----------------------------------------------------

# Ιδιωτικό repo για τα νυχτερινά αντίγραφα της βάσης, μέσω deploy key με
# δικαίωμα εγγραφής. Κενό = μόνο τοπικά αντίγραφα.
BACKUP_GIT_REMOTE=

# Πόσες ημέρες κρατάμε αντίγραφα.
BACKUP_KEEP_DAYS=14
